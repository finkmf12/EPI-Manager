# Never commit real credentials. Copy to .env locally and keep it out of Git.
# Use the Supabase Session Pooler connection details from the project dashboard.
DB_URL="jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require&currentSchema=epi_manager"
DB_USERNAME=epi_manager_app.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_THE_PASSWORD_SET_FOR_EPI_MANAGER_APP
DB_POOL_MAX=10
DB_POOL_MIN=2

# Generate with: openssl rand -base64 48
JWT_SECRET_BASE64=REPLACE_WITH_A_RANDOM_BASE64_SECRET
JWT_ISSUER=epi-manager-api
JWT_ACCESS_TTL=PT15M
JWT_SELECTION_TTL=PT3M

# Comma-separated exact frontend origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
API_DOCS_PUBLIC=true
REGISTRATION_ENABLED=true
