# Vercel Container Runtime entrypoint for the Spring Boot API.
# Keep this file aligned with Dockerfile; Vercel detects Dockerfile.vercel
# and builds the API as a stateless HTTP container function.
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system spring && useradd --system --gid spring --home-dir /app spring
COPY --from=build /workspace/target/epi-manager-api-0.1.0-SNAPSHOT.jar /app/app.jar
USER spring:spring
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
